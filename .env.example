# Site (Vercel) : adresse du serveur de découpage, sans chemin. Laisser vide si tout tourne sur le même serveur.
NEXT_PUBLIC_VICECLIP_API=

# Serveur de découpage : sites autorisés à l'appeler, séparés par des virgules.
VICECLIP_ALLOWED_ORIGINS=

# Serveur de découpage : clé d'API Mollie pour les abonnements (test_… ou live_…). Ne jamais la versionner.
MOLLIE_API_KEY=

# Serveur de découpage : clé d'API Anthropic pour les titres écrits par l'IA. Ne jamais la versionner.
ANTHROPIC_API_KEY=

# Serveur de découpage : réglages facultatifs.
# VICECLIP_TITLE_MODEL=claude-opus-5-5
# VICECLIP_DB_DIR=/data
# VICECLIP_DATA_DIR=/work
# VICECLIP_MAX_MINUTES=90
# YTDLP_COOKIES=/data/cookies.txt
# YTDLP_PROXY=
